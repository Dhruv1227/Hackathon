GEMINI_API_KEY=
GEMINI_MODEL=            # empty = proxy default (gemini-3-flash-preview)
# Proxy / gateway (hackathon keys): the base URL from your key instructions.
#   OpenAI-compatible proxies usually end in /v1  -> backend "openai" is picked automatically
#   Gemini-native proxies                         -> set GEMINI_BACKEND=google
GEMINI_BASE_URL=https://hackathon-api-new-152590733511.northamerica-northeast2.run.app
GEMINI_BACKEND=hackathon
# Only if the proxy wants the key in a custom header instead of "Authorization: Bearer <key>"
# GEMINI_AUTH_HEADER=x-api-key
# Vertex AI instead: set GOOGLE_CLOUD_PROJECT (+ GOOGLE_CLOUD_LOCATION) and use gcloud ADC
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
